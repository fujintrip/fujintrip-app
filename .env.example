# FujinTrip — copy to .env.local for local dev. Never commit a real key.
# DigitalOcean App Platform: set these in the dashboard (Settings > App-Level Environment Variables).

# Managed Postgres (fujintrip-db) — DigitalOcean injects this as a bound variable; placeholder only.
DATABASE_URL=postgresql://doadmin:REPLACE_ME@fujintrip-db-do-user-0.d.db.ondigitalocean.com:25060/defaultdb?sslmode=require

# Spaces (fujintrip-images)
SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com
SPACES_BUCKET=fujintrip-images
SPACES_REGION=nyc3
SPACES_KEY=REPLACE_ME
SPACES_SECRET=REPLACE_ME

# Duffel flights — server-side only. Leave empty for labeled planning estimates.
DUFFEL_API_KEY=
# DUFFEL_API_KEY=duffel_test_REPLACE_ME

# Fujin AI (live model) — server-side only. Leave empty and the chat
# uses the built-in planner. Qwen is active when its key is set (cheapest,
# ~$1 per 1,000 trip plans); Meta Muse is the fallback when only its key
# is set. Get a Qwen key at Alibaba Cloud Model Studio, INTERNATIONAL
# endpoint (Singapore) → API keys. New accounts get free trial tokens.
# Never commit a real key.
QWEN_API_KEY=

# Fujin AI fallback (Meta Muse) — server-side only. Get a key at
# dev.meta.ai (Model API dashboard → API keys → Create API key).
MODEL_API_KEY=

# Plan PDF download ($1 / free when booked) — Stripe Checkout, NOT connected yet.
# To collect the $1: create a Stripe account, get the secret key, and set it
# here (DigitalOcean dashboard → App-Level Environment Variables). The
# plan-download route returns stripe_not_configured until then, and the
# $1 button explains that instead of charging anything. Never commit a real key.
STRIPE_SECRET_KEY=

# Travelpayouts Data API — cached Aviasales comparison fares for the
# "Other sites" column ("Travelpayouts now — cached, labelled", user
# chose Nov 12, 2026). Free token, auto-generated at signup: register at
# Travelpayouts, then Profile → API token (app.travelpayouts.com). Set it
# here (DigitalOcean dashboard → App-Level Environment Variables) — the
# column stays honestly empty until then. Server-side only, never commit
# a real key. No token = no signup, no charge.
TRAVELPAYOUTS_TOKEN=

# Free-account sign-in — Clerk (user chose Nov 14, 2026: Clerk +
# email magic link, no Google). Create the account at clerk.com, then
# copy the two keys from the Clerk dashboard (API Keys) and set them
# here (DigitalOcean dashboard → App-Level Environment Variables), then
# Deploy. Until these are set the site works exactly as before — the
# gate shows "sign-in isn't set up yet" and browsing, tabs, results
# and chat stay free. In the Clerk dashboard also enable the magic
# link: User & Authentication → Email, Phone, Username → Authentication
# strategies → Email verification link ON (Google stays OFF unless the
# user asks for it later — one toggle in the dashboard). Clerk sends
# the magic-link emails; no separate email account needed. Free Hobby
# tier: $0 to 50,000 monthly retained users. Never commit a real key.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Google AdSense — DORMANT by default. Ads render only when a publisher ID
# and slot IDs are set, after AdSense approval. Leave empty until then.
NEXT_PUBLIC_ADSENSE_ID=
# NEXT_PUBLIC_ADSENSE_ID=ca-pub-REPLACE_ME
NEXT_PUBLIC_ADSENSE_SLOT_BELOW_GEMS=
NEXT_PUBLIC_ADSENSE_SLOT_ABOVE_FOOTER=
