# FujinTrip — copy to .env.local for local dev. Never commit a real key.
# DigitalOcean App Platform: set these in the dashboard (Settings > App-Level Environment Variables).

# Managed Postgres (fujintrip-db) — DigitalOcean injects this as a bound variable; placeholder only.
DATABASE_URL=postgresql://doadmin:REPLACE_ME@fujintrip-db-do-user-0.d.db.ondigitalocean.com:25060/defaultdb?sslmode=require

# Spaces (fujintrip-images)
SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com
SPACES_BUCKET=fujintrip-images
SPACES_REGION=nyc3
SPACES_KEY=REPLACE_ME
SPACES_SECRET=REPLACE_ME

# Duffel flights — server-side only. Leave empty for labeled planning estimates.
DUFFEL_API_KEY=
# DUFFEL_API_KEY=duffel_test_REPLACE_ME
